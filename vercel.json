{
    "buildCommand": "npm run build",
    "outputDirectory": "dist/public",
    "installCommand": "npm install --legacy-peer-deps",
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "https://zetatraveler.onrender.com/api/:path*"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }